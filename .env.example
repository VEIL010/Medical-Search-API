# Documentation only: export these variables before starting uvicorn.
# Do not commit real tokens or patient data. The application does not auto-load .env.
VEIL_DATA_DIR=data/heart
VEIL_DATASET_DIR=.local/datasets
# Set one random secret on both the API and the institution service.
VEIL_API_KEY=
# Optional dedicated write token; falls back to VEIL_API_KEY when empty.
VEIL_ENROLLMENT_API_KEY=
VEIL_MAX_TOP_K=50
VEIL_MAX_BODY_BYTES=67108864
